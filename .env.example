# Copie este archivo como .env y ajuste los valores. El archivo .env NUNCA se sube a git.

# Carpeta donde se guardan los archivos cargados y la base de datos local.
RUTA_DATOS=datos

# Cadena de conexión de la base de datos.
# Vacía = SQLite dentro de RUTA_DATOS (datos/auditoria.db).
# Futuro: postgresql+psycopg://usuario:clave@servidor/auditoria_soat
URL_BASE_DATOS=

# OCR opcional para PDF escaneados: ninguno | tesseract
# Tesseract es gratuito; solo se usa si está instalado con el idioma español (spa).
OCR_MOTOR=ninguno
# Ruta a tesseract.exe si no está en el PATH (ej. C:\Program Files\Tesseract-OCR\tesseract.exe)
RUTA_TESSERACT=

# Proveedor de IA: desactivado | puente_manual | anthropic | ollama
# En esta etapa: desactivado o puente_manual (sin costo).
PROVEEDOR_IA=desactivado

# API de Anthropic: preparada pero desactivada. Dejar vacío mientras no haya presupuesto.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=
